{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Any Prometheus-compatible backend receiving the OTLP metrics (Prometheus, Mimir, VictoriaMetrics, Grafana Cloud).",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": { "list": [] },
  "description": "RustStream service dashboard over the ruststream `otel` feature's metrics inventory. Panel queries use the Prometheus rendering of the OpenTelemetry names (dots to underscores, unit and _total suffixes).",
  "editable": true,
  "graphTooltip": 1,
  "links": [
    {
      "title": "Metric contract (README)",
      "type": "link",
      "url": "https://github.com/powersemmi/ruststream-grafana"
    }
  ],
  "panels": [
    { "type": "row", "title": "Overview", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "panels": [] },
    {
      "type": "stat",
      "title": "App state",
      "description": "ruststream_app_state: 1 for the active lifecycle state (running / shutting_down / stopped / failed).",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 4, "x": 0, "y": 1 },
      "targets": [
        {
          "expr": "max by (state) (ruststream_app_state{job=~\"$job\"} == 1)",
          "legendFormat": "{{state}}",
          "refId": "A"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "/^state$/" }, "textMode": "name" }
    },
    {
      "type": "timeseries",
      "title": "Consumed messages / s",
      "description": "messaging_client_consumed_messages_total, per handler.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 10, "x": 4, "y": 1 },
      "targets": [
        {
          "expr": "sum by (messaging_destination_name) (rate(messaging_client_consumed_messages_total{job=~\"$job\", messaging_destination_name=~\"$handler\"}[$__rate_interval]))",
          "legendFormat": "{{messaging_destination_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Published messages / s",
      "description": "messaging_client_sent_messages_total, per destination; error.type-labeled series are failures.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 10, "x": 14, "y": 1 },
      "targets": [
        {
          "expr": "sum by (messaging_destination_name) (rate(messaging_client_sent_messages_total{job=~\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{messaging_destination_name}}",
          "refId": "A"
        },
        {
          "expr": "sum(rate(messaging_client_sent_messages_total{job=~\"$job\", error_type!=\"\"}[$__rate_interval]))",
          "legendFormat": "publish errors",
          "refId": "B"
        }
      ]
    },
    { "type": "row", "title": "Per handler", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 }, "panels": [] },
    {
      "type": "timeseries",
      "title": "Processing duration quantiles",
      "description": "messaging_process_duration_seconds histogram: p50 / p95 / p99 for the selected handlers.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, messaging_destination_name) (rate(messaging_process_duration_seconds_bucket{job=~\"$job\", messaging_destination_name=~\"$handler\"}[$__rate_interval])))",
          "legendFormat": "p50 {{messaging_destination_name}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, messaging_destination_name) (rate(messaging_process_duration_seconds_bucket{job=~\"$job\", messaging_destination_name=~\"$handler\"}[$__rate_interval])))",
          "legendFormat": "p95 {{messaging_destination_name}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, messaging_destination_name) (rate(messaging_process_duration_seconds_bucket{job=~\"$job\", messaging_destination_name=~\"$handler\"}[$__rate_interval])))",
          "legendFormat": "p99 {{messaging_destination_name}}",
          "refId": "C"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "In flight vs workers",
      "description": "ruststream_messages_in_flight: deliveries inside handlers right now. Flat at the workers(n) cap means the pool is saturated.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum by (messaging_destination_name) (ruststream_messages_in_flight{job=~\"$job\", messaging_destination_name=~\"$handler\"})",
          "legendFormat": "{{messaging_destination_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Queue time p95 (consumer lag proxy)",
      "description": "ruststream_message_queue_time_seconds: publish-to-handler-start, from the stamped publish-time header.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 15 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, messaging_destination_name) (rate(ruststream_message_queue_time_seconds_bucket{job=~\"$job\", messaging_destination_name=~\"$handler\"}[$__rate_interval])))",
          "legendFormat": "{{messaging_destination_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Payload size p95",
      "description": "ruststream_message_payload_size_bytes histogram; the OTLP data points also carry min / max / sum / count.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 15 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, messaging_destination_name) (rate(ruststream_message_payload_size_bytes_bucket{job=~\"$job\"}[$__rate_interval])))",
          "legendFormat": "{{messaging_destination_name}}",
          "refId": "A"
        }
      ]
    },
    { "type": "row", "title": "Failures and outcomes", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 }, "panels": [] },
    {
      "type": "timeseries",
      "title": "Settlement outcomes / s",
      "description": "ruststream_messages_processed_total by outcome: ack, nack_requeue, nack_drop, retry_after.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 23 },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(ruststream_messages_processed_total{job=~\"$job\", messaging_destination_name=~\"$handler\"}[$__rate_interval]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Non-ack rate per handler",
      "description": "Everything that did not ack: requeues, drops, and delayed retries.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 23 },
      "targets": [
        {
          "expr": "sum by (messaging_destination_name, outcome) (rate(ruststream_messages_processed_total{job=~\"$job\", outcome!=\"ack\", messaging_destination_name=~\"$handler\"}[$__rate_interval]))",
          "legendFormat": "{{messaging_destination_name}} {{outcome}}",
          "refId": "A"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["ruststream", "messaging", "opentelemetry"],
  "templating": {
    "list": [
      {
        "name": "job",
        "label": "Service",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": "label_values(messaging_client_consumed_messages_total, job)",
        "includeAll": true,
        "multi": true,
        "refresh": 2
      },
      {
        "name": "handler",
        "label": "Handler",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": "label_values(messaging_client_consumed_messages_total{job=~\"$job\"}, messaging_destination_name)",
        "includeAll": true,
        "multi": true,
        "refresh": 2
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "title": "RustStream service",
  "uid": "ruststream",
  "version": 1
}
