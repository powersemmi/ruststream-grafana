    {
      "id": 7,
      "type": "bargauge",
      "title": "Publish average duration",
      "description": "Mean publish operation time per destination over the range.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 3,
        "y": 5,
        "w": 7,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "N/A",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "continuous-GrYlRd"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (messaging_destination_name) (increase(messaging_client_operation_duration_seconds_sum{job=~\"$job\", messaging_destination_name=~\"$destination\"}[$__range])) / sum by (messaging_destination_name) (increase(messaging_client_operation_duration_seconds_count{job=~\"$job\", messaging_destination_name=~\"$destination\"}[$__range]))",
          "legendFormat": "{{messaging_destination_name}}",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "displayMode": "lcd",
        "orientation": "horizontal",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "auto",
        "sizing": "auto",
        "minVizHeight": 16,
        "minVizWidth": 8,
        "maxVizHeight": 300,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
